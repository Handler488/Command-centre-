# --- Command Centre configuration -------------------------------------------
# Copy to .env. Everything is optional: the platform runs without any keys.

# AI analyst (chat + AI-written reports). Without it the Analyst desk offers
# deterministic data digests only. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used by the analyst. Default: claude-opus-5-5
ANALYST_MODEL=

# SEC EDGAR asks API clients to identify themselves with a contact address
# (https://www.sec.gov/os/accessing-edgar-data). Set e.g. "Your Name you@example.com".
SEC_USER_AGENT=

# Server
PORT=4000
# Interface to bind. Keep 127.0.0.1 unless you put your own authentication in front:
# the app has no login and holds personal data.
HOST=127.0.0.1
DATABASE_PATH=./data/command-centre.db
# Minutes between background news refreshes (0 disables the scheduler)
NEWS_REFRESH_MINUTES=15
